<Window x:Class="laba13.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:laba13.Views"
        mc:Ignorable="d"
        Title="PhoneBook" Height="450" Width="800">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="LightGray">
            <Button Content="Contacts" Command="{Binding ShowContactsCommand}" Margin="10 5"/>
            <Button Content="AboutProgram" Command="{Binding ShowAboutCommand}" Margin="10 5"/>
        </StackPanel>

        <ContentControl Content="{Binding NavigationService.CurrentViewModel}" />
    </DockPanel>
</Window>